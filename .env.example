# ============================================================
# Movie Analysis Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in actual values.
# .env MUST NOT be committed to Git.

# --- Database ---
# SQLite (development): sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production): postgresql+asyncpg://user:password@host:5432/movie_analysis
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
# Local development: ./data
# Production: s3://bucket-name or /mnt/data
STORAGE_ROOT=./data

# --- Model Store ---
# Local: ./model_store
# Production: /models or s3://model-bucket
MODEL_STORE_ROOT=./model_store

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
DEBUG=true
