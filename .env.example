# ============================================================
# Movie Analysis Platform — Environment Variables
# ============================================================
# Copy to .env and adjust values.
# .env MUST NOT be committed to Git.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (development): sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@host:5432/movie_analysis
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Storage ---
STORAGE_ROOT=./data
MODEL_STORE_ROOT=./model_store

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
DEFAULT_PROJECT_ID=00000000000000000000000000000000

# --- DeepSeek API (modelarts-maas) ---
DEEPSEEK_API_KEY=
SUBTITLE_LLM_MODEL=deepseek-v4-flash
SUBTITLE_SEMANTIC_LOCAL_CONCURRENCY=3
SUBTITLE_LLM_BASE_URL=https://api.modelarts-maas.com/v1/chat/completions
SUBTITLE_SEMANTIC_GLOBAL_LIMIT=10
SUBTITLE_SEMANTIC_LOCAL_LIMIT=5
SUBTITLE_SEMANTIC_SUMMARY_CHUNK_CHARS=12000
SUBTITLE_SEMANTIC_SUMMARY_CHUNK_DURATION_MS=900000
SUBTITLE_SEMANTIC_CONTEXT_MS=90000
SUBTITLE_SEMANTIC_RESCORE_BATCH_SIZE=20
SUBTITLE_SEMANTIC_MAX_SNAP_MS=8000
SUBTITLE_SEMANTIC_MAX_SNAP_SHOTS=2

# --- Doubao Vision API (Volcano Ark) ---
# Seed-1.6-vision for scene boundary scoring
VOLC_VISION_API_KEY=

# --- Doubao ASR API (Volcano Ark) ---
# SeedASR for subtitle transcription
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=

# --- Doubao ASR Audio URL ---
# Publicly reachable URL for SeedASR to download audio files.
# MUST use HTTPS (ngrok free tier provides https://xxxx.ngrok-free.app)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# ngrok agent credential. The Compose ngrok service forwards only the
# Provider Gateway, never the main FastAPI application.
NGROK_AUTHTOKEN=

# --- Artifact URL Signing ---
# Secret key for HMAC artifact download/provider URLs.
# Minimum 32 chars in production.
ARTIFACT_SIGNING_SECRET=change-me-in-production
PROVIDER_URL_TTL_SECONDS=1800
PROVIDER_INTERNAL_URL=http://localhost:8001
