# ============================================================
# Movie Analysis Platform — Environment Variables
# ============================================================
# Copy to .env and adjust values.
# .env MUST NOT be committed to Git.
#
# These variables are validated at startup by core/config.py.
# Missing required variables cause a fast-fail with clear error.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (development): sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@host:5432/movie_analysis
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage ---
# local: ./data
# s3: (not yet implemented)
STORAGE_BACKEND=local
STORAGE_ROOT=./data

# --- Model Store ---
MODEL_STORE_ROOT=./model_store

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Maintenance ---
MAINTENANCE_DRY_RUN=false
